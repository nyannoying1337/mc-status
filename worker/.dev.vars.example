# Local development secrets for `wrangler dev`, and for tools/preview.py.
#
# Copy this to worker/.dev.vars (gitignored) and change nothing — these values are
# meant to be public. They are what a local Worker checks pushes and invite links
# against, and nothing outside your machine ever sees them.
#
# The real ones are generated by `python setup.py` and live only in Cloudflare.

# The status page
PUSH_TOKEN=local-push-token
VIEW_KEY=local-view-key

# The optional server tool (worker/server.js)
SERVER_PUSH_TOKEN=local-server-token
ADMIN_KEY=local-admin-key
CONTROL_KEY=local-control-key
PLAYER_LINK_SECRET=local-link-secret
